---
interface Props {
  eyebrow: string;
  title: string;
  body: string;
  label: string;
}
const { eyebrow, title, body, label } = Astro.props;
---

<article class="pending-card">
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  <p>{body}</p>
  <span class="pending-label">{label}</span>
</article>

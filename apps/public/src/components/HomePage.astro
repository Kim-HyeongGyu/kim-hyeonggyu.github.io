---
import SiteLayout from "../layouts/SiteLayout.astro";
import { copy, type Locale } from "../i18n";
import { profile, visibleBlocks } from "../content/profile";
import photo from "../assets/profile.jpg";
import WorkMap from "./WorkMap.astro";

interface Props {
  locale: Locale;
}

// Every block renders only when profile.ts has data for it (owner request, 2026-10-18).
const { locale } = Astro.props;
const name = profile.name[locale];
const blocks = visibleBlocks(profile, locale);
const photoAlt = profile.photoAlt[locale];
const content = copy[locale];
const timelines = [
  { id: "education", heading: content.education, items: blocks.education },
  { id: "experience", heading: content.experience, items: blocks.experience },
];
---

<SiteLayout locale={locale} page="home" title={name} description={blocks.roleLine ? `${name}, ${blocks.roleLine}` : name}>
  <div class="intro">
    <div>
      <h1>{name}</h1>
      {blocks.roleLine && <p class="role">{blocks.roleLine}</p>}
    </div>
    {photoAlt && <img class="portrait" src={photo.src} width="160" height="160" alt={photoAlt} decoding="async" />}
  </div>
  {blocks.bio.map((paragraph) => <p>{paragraph}</p>)}
  {timelines.map((list) => list.items.length > 0 && (
    <section aria-labelledby={list.id}>
      <h2 id={list.id}>{list.heading}</h2>
      <ul class="timeline">
        {list.items.map((item) => (
          <li><span class="period">{item.period}</span><span>{item.text}</span></li>
        ))}
      </ul>
    </section>
  ))}
  {blocks.places.length > 0 && <WorkMap places={blocks.places} locale={locale} heading={content.places} koreaLabel={content.korea} />}
</SiteLayout>

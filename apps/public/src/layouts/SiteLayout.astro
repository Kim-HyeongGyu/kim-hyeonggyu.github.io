---
import "../../../../packages/ui-tokens/tokens.css";
import "../styles/public.css";
import fontLicense from "../../../../packages/ui-tokens/fonts/OFL.txt?url";
import { copy, localePath, routeKeys, type Locale, type RouteKey } from "../i18n";

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
}

const { locale, routeKey, title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const content = copy[locale];
const links = routeKeys.map((key) => ({ key, href: localePath(base, locale, key), label: content.nav[key] }));
const koreanHref = localePath(base, "ko", routeKey);
const englishHref = localePath(base, "en", routeKey);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="license" href={fontLicense} />
    <link rel="alternate" hreflang="ko" href={koreanHref} />
    <link rel="alternate" hreflang="en" href={englishHref} />
    <link rel="alternate" hreflang="x-default" href={koreanHref} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{content.skipLink}</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href={localePath(base, locale, "home")} aria-label={content.homeLabel}>
          <span>HGK</span>
          <small>research notebook</small>
        </a>
        <div class="header-actions">
          <nav class="primary-nav" aria-label={content.primaryNavLabel}>
            <ul>
              {links.map((link) => (
                <li><a href={link.href} aria-current={routeKey === link.key ? "page" : undefined}>{link.label}</a></li>
              ))}
            </ul>
          </nav>
          <nav class="language-switch" aria-label={content.languageNavLabel}>
            <a href={koreanHref} lang="ko" hreflang="ko" aria-current={locale === "ko" ? "true" : undefined}>한국어</a>
            <span aria-hidden="true">/</span>
            <a href={englishHref} lang="en" hreflang="en" aria-current={locale === "en" ? "true" : undefined}>English</a>
          </nav>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <p><strong>Hyeong-Gyu Kim</strong><br />Research notebook</p>
        <p>{content.footerBoundary}</p>
      </div>
    </footer>
  </body>
</html>
